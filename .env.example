# Copy this file to `.env` and fill in the values. See docs/SIGN_IN_SETUP.md.
# These are public client IDs (they ship inside the app), not secrets.

# Firebase console → Project settings → General → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Cloud console → APIs & Services → Credentials (same project as Firebase)
# "Web client (auto created by Google Service)" — Firebase needs this one
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS OAuth client for bundle ID com.robertsbuildinggroup.mineralhunter
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
