{
  "expo": {
    "name": "Mineral Hunter",
    "slug": "mineral-hunting-app",
    "scheme": "mineralhunter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.robertsbuildinggroup.mineralhunter",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#040E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.robertsbuildinggroup.mineralhunter"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Mineral Hunter uses the camera to point you toward nearby mine and mineral sites.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mineral Hunter uses your location to show mineral sites near you and point you toward them."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#021F46",
          "image": "./assets/images/splash-bg.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ]
  }
}
